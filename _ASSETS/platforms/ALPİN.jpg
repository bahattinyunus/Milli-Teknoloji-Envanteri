aCLV.webp 540w, /_astro/spraying-433.v7esQUi8_Z1xBVpX.webp 720w" type="image/webp" sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 380px">  <img src="/_astro/spraying-433.v7esQUi8_s7zoy.jpg" srcset="/_astro/spraying-433.v7esQUi8_1Q9imj.jpg 360w, /_astro/spraying-433.v7esQUi8_2iGYIh.jpg 540w, /_astro/spraying-433.v7esQUi8_Z2jVrIG.jpg 720w" alt sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 380px" loading="lazy" data-astro-cid-sbmovh4h="true" decoding="async" data-astro-image="constrained" data-astro-image-fit="cover" data-astro-image-pos="center" width="807" height="535"> </picture> </div> <div class="body" data-astro-cid-sbmovh4h>  <h3 class="title" data-astro-cid-sbmovh4h="true"> <a class="stretch" href="/agricultural-services/" data-astro-cid-sbmovh4h> Agriculture </a> </h3> <p class="line" data-astro-cid-sbmovh4h>UAVOS aircraft fly infrared sensors and NDVI cameras over crops for field health maps, soil moisture, growth progress and yield estimates in real time.</p> </div> </article><article class="card post" data-astro-cid-sbmovh4h> <div class="pic contain" data-astro-cid-sbmovh4h>  <picture data-astro-cid-sbmovh4h="true"> <source srcset="/_astro/helicopter-over-helipad.IPfnEi2G_1Jfeo6.avif 360w, /_astro/helicopter-over-helipad.IPfnEi2G_Z5XNoI.avif 540w, /_astro/helicopter-over-helipad.IPfnEi2G_Z1zs5UY.avif 720w" type="image/avif" sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 380px"><source srcset="/_astro/helicopter-over-helipad.IPfnEi2G_23vlWg.webp 360w, /_astro/helicopter-over-helipad.IPfnEi2G_dhj9r.webp 540w, /_astro/helicopter-over-helipad.IPfnEi2G_Z1gbXmO.webp 720w" type="image/webp" sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 380px">  <img src="/_astro/helicopter-over-helipad.IPfnEi2G_Z41hpV.jpg" srcset="/_astro/helicopter-over-helipad.IPfnEi2G_Zn03KI.jpg 360w, /_astro/helicopter-over-helipad.IPfnEi2G_Z2de6yx.jpg 540w, /_astro/helicopter-over-helipad.IPfnEi2G_1ntJI8.jpg 720w" alt sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 380px" loading="lazy" data-astro-cid-sbmovh4h="true" decoding="async" data-astro-image="constrained" data-astro-image-fit="cover" data-astro-image-pos="center" width="1280" height="960"> </picture> </div> <div class="body" data-astro-cid-sbmovh4h>  <h3 class="title" data-astro-cid-sbmovh4h="true"> <a class="stretch" href="/surveying-and-gis-mapping/" data-astro-cid-sbmovh4h> Surveying and GIS mapping </a> </h3> <p class="line" data-astro-cid-sbmovh4h>Aerial surveys captured in a single flight and processed into orthomosaics and geo-referenced 3D models for GIS and CAD.</p> </div> </article><article class="card post" data-astro-cid-sbmovh4h> <div class="pic contain" data-astro-cid-sbmovh4h>  <picture data-astro-cid-sbmovh4h="true"> <source srcset="/_astro/uvhel5.mriScsnb_qpSF1.avif 360w, /_astro/uvhel5.mriScsnb_8wALJ.avif 540w, /_astro/uvhel5.mriScsnb_Z11gLvF.avif 720w" type="image/avif" sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 380px"><source srcset="/_astro/uvhel5.mriScsnb_1DWy4d.webp 360w, /_astro/uvhel5.mriScsnb_1m4gaV.webp 540w, /_astro/uvhel5.mriScsnb_cfRRw.webp 720w" type="image/webp" sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 380px">  <img src="/_astro/uvhel5.mriScsnb_ZzPLIf.jpg" srcset="/_astro/uvhel5.mriScsnb_2rDwKM.jpg 360w, /_astro/uvhel5.mriScsnb_29KeRv.jpg 540w, /_astro/uvhel5.mriScsnb_YVQz6.jpg 720w" alt sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 380px" loading="lazy" data-astro-cid-sbmovh4h="true" decoding="async" data-astro-image="constrained" data-astro-image-fit="cover" data-astro-image-pos="center" width="1546" height="1090"> </picture> </div> <div class="body" data-astro-cid-sbmovh4h>  <h3 class="title" data-astro-cid-sbmovh4h="true"> <a class="stretch" href="/industrial-inspections-oil-gas-industry/" data-astro-cid-sbmovh4h> Oil and gas inspections </a> </h3> <p class="line" data-astro-cid-sbmovh4h>UAV inspection of remote oil and gas assets, power lines, bridges, wind turbines and railways, from right-of-way surveys to emergency response.</p> </div> </article><article class="card post" data-astro-cid-sbmovh4h> <div class="pic contain" data-astro-cid-sbmovh4h>  <picture data-astro-cid-sbmovh4h="true"> <source srcset="/_astro/sitar28.B_co9tRd_Z1vjjDd.avif 360w, /_astro/sitar28.B_co9tRd_ZrFYbr.avif 540w, /_astro/sitar28.B_co9tRd_ZfXJ8N.avif 720w" type="image/avif" sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 380px"><source srcset="/_astro/sitar28.B_co9tRd_ZhLEf1.webp 360w, /_astro/sitar28.B_co9tRd_KPFcK.webp 540w, /_astro/sitar28.B_co9tRd_WxUfo.webp 720w" type="image/webp" sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 380px">  <img src="/_astro/sitar28.B_co9tRd_Zlyc7V.jpg" srcset="/_astro/sitar28.B_co9tRd_uTjry.jpg 360w, /_astro/sitar28.B_co9tRd_1ywDTk.jpg 540w, /_astro/sitar28.B_co9tRd_1KeSVX.jpg 720w" alt sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 380px" loading="lazy" data-astro-cid-sbmovh4h="true" decoding="async" data-astro-image="constrained" data-astro-image-fit="cover" data-astro-image-pos="center" width="1406" height="421"> </picture> </div> <div class="body" data-astro-cid-sbmovh4h>  <h3 class="title" data-astro-cid-sbmovh4h="true"> <a class="stretch" href="/land-and-constructions-services/" data-astro-cid-sbmovh4h> Land development and construction </a> </h3> <p class="line" data-astro-cid-sbmovh4h>Persistent UAV monitoring of urban assets and construction sites in environments that are difficult to access.</p> </div> </article><article class="card post" data-astro-cid-sbmovh4h> <div class="pic contain" data-astro-cid-sbmovh4h>  <picture data-astro-cid-sbmovh4h="true"> <source srcset="/_astro/solar-powered-33-6e37660d.Cz5CWXLr_Z283cUk.avif 360w, /_astro/solar-powered-33-6e37660d.Cz5CWXLr_2ve3gu.avif 540w, /_astro/solar-powered-33-6e37660d.Cz5CWXLr_1lj16r.avif 720w" type="image/avif" sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 380px"><source srcset="/_astro/solar-powered-33-6e37660d.Cz5CWXLr_Z1xNurf.webp 360w, /_astro/solar-powered-33-6e37660d.Cz5CWXLr_Z1YIn4m.webp 540w, /_astro/solar-powered-33-6e37660d.Cz5CWXLr_1UxIzw.webp 720w" type="image/webp" sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 380px">  <img src="/_astro/solar-powered-33-6e37660d.Cz5CWXLr_158RaU.jpg" srcset="/_astro/solar-powered-33-6e37660d.Cz5CWXLr_Z2gM6n9.jpg 360w, /_astro/solar-powered-33-6e37660d.Cz5CWXLr_2mu9NF.jpg 540w, /_astro/solar-powered-33-6e37660d.Cz5CWXLr_1cz7DC.jpg 720w" alt sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 380px" loading="lazy" data-astro-cid-sbmovh4h="true" decoding="async" data-astro-image="constrained" data-astro-image-fit="cover" data-astro-image-pos="center" width="2000" height="1184"> </picture> </div> <div class="body" data-astro-cid-sbmovh4h>  <h3 class="title" data-astro-cid-sbmovh4h="true"> <a class="stretch" href="/environment-and-forestry-services/" data-astro-cid-sbmovh4h> Environment and forestry </a> </h3> <p class="line" data-astro-cid-sbmovh4h>Terrain mapping and biomass analysis from UAVOS aircraft, to minimize the impact of development on wildlife, wetlands and tree stands.</p> </div> </article><article class="card post" data-astro-cid-sbmovh4h> <div class="pic contain" data-astro-cid-sbmovh4h>  <picture data-astro-cid-sbmovh4h="true"> <source srcset="/_astro/uvh-el-dsei.qTEd7j_9_Z1sJiRC.avif 360w, /_astro/uvh-el-dsei.qTEd7j_9_1aJnro.avif 540w, /_astro/uvh-el-dsei.qTEd7j_9_Z1fX42w.avif 720w" type="image/avif" sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 380px"><source srcset="/_astro/uvh-el-dsei.qTEd7j_9_Z1i8EF9.webp 360w, /_astro/uvh-el-dsei.qTEd7j_9_1ll1DR.webp 540w, /_astro/uvh-el-dsei.qTEd7j_9_Z15mpP3.webp 720w" type="image/webp" sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 380px">  <img src="/_astro/uvh-el-dsei.qTEd7j_9_ZDsd8q.jpg" srcset="/_astro/uvh-el-dsei.qTEd7j_9_Z24saXR.jpg 360w, /_astro/uvh-el-dsei.qTEd7j_9_z1vl9.jpg 540w, /_astro/uvh-el-dsei.qTEd7j_9_Z1QFV8L.jpg 720w" alt sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 380px" loading="lazy" data-astro-cid-sbmovh4h="true" decoding="async" data-astro-image="constrained" data-astro-image-fit="cover" data-astro-image-pos="center" width="1600" height="714"> </picture> </div> <div class="body" data-astro-cid-sbmovh4h>  <h3 class="title" data-astro-cid-sbmovh4h="true"> <a class="stretch" href="/public-use/" data-astro-cid-sbmovh4h> Public use </a> </h3> <p class="line" data-astro-cid-sbmovh4h>Real-time aerial imagery for public safety, disaster assessment, search and rescue and research, by day and by night.</p> </div> </article> </div> </div> </section> <section class="section" aria-labelledby="news" data-astro-cid-lcdefpme> <div class="container" data-astro-cid-lcdefpme> <div class="head" data-reveal data-astro-cid-sjgajsms> <div class="text" data-astro-cid-sjgajsms> <span class="eyebrow" data-astro-cid-sjgajsms>Press releases</span> <h2 id="news" data-astro-cid-sjgajsms>Latest from UAVOS</h2>  </div> <div class="action" data-astro-cid-sjgajsms>  <a class="btn btn--ghost" href="/press-releases/" data-astro-cid-lcdefpme>
All press releases <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right" aria-hidden="true" data-astro-cid-lcdefpme="true"> <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>  </svg> </a>  </div> </div> <div class="cards" data-astro-cid-lcdefpme> <article class="card post" data-astro-cid-sbmovh4h> <div class="pic" data-astro-cid-sbmovh4h>  <picture data-astro-cid-sbmovh4h="true"> <source srcset="/_astro/ApusNeo-HAPS-flighs.-hfV0pPs_16cKjK.avif 360w, /_astro/ApusNeo-HAPS-flighs.-hfV0pPs_2rtxRE.avif 540w, /_astro/ApusNeo-HAPS-flighs.-hfV0pPs_Z1hqMnn.avif 720w" type="image/avif" sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 380px"><source srcset="/_astro/ApusNeo-HAPS-flighs.-hfV0pPs_2eNdXH.webp 360w, /_astro/ApusNeo-HAPS-flighs.-hfV0pPs_Z1u77hk.webp 540w, /_astro/ApusNeo-HAPS-flighs.-hfV0pPs_Z8PjIq.webp 720w" type="image/webp" sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 380px">  <img src="/_astro/ApusNeo-HAPS-flighs.-hfV0pPs_ZafUoz.jpg" srcset="/_astro/ApusNeo-HAPS-flighs.-hfV0pPs_1p8duu.jpg 360w, /_astro/ApusNeo-HAPS-flighs.-hfV0pPs_Z2jM7Kx.jpg 540w, /_astro/ApusNeo-HAPS-flighs.-hfV0pPs_ZXvkcD.jpg 720w" alt sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 380px" loading="lazy" data-astro-cid-sbmovh4h="true" decoding="async" data-astro-image="constrained" data-astro-image-fit="cover" data-astro-image-pos="center" width="1862" height="1044"> </picture> </div> <div class="body" data-astro-cid-sbmovh4h> <p class="meta" data-astro-cid-sbmovh4h>   <time datetime="2026-11-12" data-astro-cid-sbmovh4h>November 12, 2026</time> </p> <h3 class="title" data-astro-cid-sbmovh4h="true"> <a class="stretch" href="/apusneo-haps-completes-record-breaking-100-hour-flight-in-european-airspace/" data-astro-cid-sbmovh4h> ApusNeo HAPS completes record-breaking 100-hour flight in European airspace </a> </h3> <p class="line" data-astro-cid-sbmovh4h>UAVOS, a founding technology partner of Mira Aerospace, announces the successful completion of a record-breaking flight campaign by its ApusNeo HAPS (High-Altitude Platform Station) aircraft, achieving a total flight duration of 100 hours and 50 minutes.</p> </div> </article><article class="card post" data-astro-cid-sbmovh4h> <div class="pic" data-astro-cid-sbmovh4h>  <picture data-astro-cid-sbmovh4h="true"> <source srcset="/_astro/ApusNeo18_5.D7cmeOA4_ZGDvXB.avif 360w, /_astro/ApusNeo18_5.D7cmeOA4_ZU8CUa.avif 540w, /_astro/ApusNeo18_5.D7cmeOA4_2csPll.avif 720w" type="image/avif" sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 380px"><source srcset="/_astro/ApusNeo18_5.D7cmeOA4_BJsCi.webp 360w, /_astro/ApusNeo18_5.D7cmeOA4_oflFJ.webp 540w, /_astro/ApusNeo18_5.D7cmeOA4_Z1ykiQG.webp 720w" type="image/webp" sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 380px">  <img src="/_astro/ApusNeo18_5.D7cmeOA4_Z1G3ldO.png" srcset="/_astro/ApusNeo18_5.D7cmeOA4_3T9Qa.png 360w, /_astro/ApusNeo18_5.D7cmeOA4_Z9zW5o.png 540w, /_astro/ApusNeo18_5.D7cmeOA4_Z27aBCO.png 720w" alt sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 380px" loading="lazy" data-astro-cid-sbmovh4h="true" decoding="async" data-astro-image="constrained" data-astro-image-fit="cover" data-astro-image-pos="center" width="733" height="612"> </picture> </div> <div class="body" data-astro-cid-sbmovh4h> <p class="meta" data-astro-cid-sbmovh4h>   <time datetime="2026-10-28" data-astro-cid-sbmovh4h>October 28, 2026</time> </p> <h3 class="title" data-astro-cid-sbmovh4h="true"> <a class="stretch" href="/apusneo-haps-completes-first-flight-at-14500-meters-in-european-airspace/" data-astro-cid-sbmovh4h> ApusNeo HAPS completes first flight at 14,500 meters in European airspace </a> </h3> <p class="line" data-astro-cid-sbmovh4h>UAVOS Inc., the founding technology partner of Mira Aerospace, announced the successful completion of the first flight of the ApusNeo HAPS stratospheric aircraft in European airspace, reaching an altitude of 14,500 meters (approximately 47,600 feet).</p> </div> </article><article class="card post" data-astro-cid-sbmovh4h> <div class="pic" data-astro-cid-sbmovh4h>  <picture data-astro-cid-sbmovh4h="true"> <source srcset="/_astro/APX-Autopilot.C1iGPryX_11rhW2.avif 360w, /_astro/APX-Autopilot.C1iGPryX_Z1r9Bol.avif 540w, /_astro/APX-Autopilot.C1iGPryX_1nfhqg.avif 720w" type="image/avif" sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 380px"><source srcset="/_astro/APX-Autopilot.C1iGPryX_1odHjI.webp 360w, /_astro/APX-Autopilot.C1iGPryX_Z14nc1E.webp 540w, /_astro/APX-Autopilot.C1iGPryX_1K1GMW.webp 720w" type="image/webp" sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 380px">  <img src="/_astro/APX-Autopilot.C1iGPryX_1TilC3.jpg" srcset="/_astro/APX-Autopilot.C1iGPryX_Z1fTW1P.jpg 360w, /_astro/APX-Autopilot.C1iGPryX_1lFhqI.jpg 540w, /_astro/APX-Autopilot.C1iGPryX_ZT6WxB.jpg 720w" alt sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 380px" loading="lazy" data-astro-cid-sbmovh4h="true" decoding="async" data-astro-image="constrained" data-astro-image-fit="cover" data-astro-image-pos="center" width="2000" height="1585"> </picture> </div> <div class="body" data-astro-cid-sbmovh4h> <p class="meta" data-astro-cid-sbmovh4h>   <time datetime="2026-10-19" data-astro-cid-sbmovh4h>October 19, 2026</time> </p> <h3 class="title" data-astro-cid-sbmovh4h="true"> <a class="stretch" href="/uavos-apx-autopilot-surpasses-100-000-flight-hours-enabling-rapid-integration-without-replacing-existing-ecosystems/" data-astro-cid-sbmovh4h> UAVOS™ APX Autopilot surpasses 100,000 flight hours, enabling rapid integration without replacing existing ecosystems </a> </h3> <p class="line" data-astro-cid-sbmovh4h>UAVOS Inc. has announced that its proprietary APX Autopilot has surpassed 100,000 flight hours across a broad range of unmanned platforms, from small UAS and heavy-lift unmanned helicopters to high-altitude stratospheric aircraft.</p> </div> </article> </div> </div> </section> <section class="cta" aria-label="Tell us about your project" data-astro-cid-6a2uyp33>  <picture data-astro-cid-6a2uyp33="true"> <source srcset="/_astro/above-the-clouds.CqSPGqOP_Z299var.avif 768w, /_astro/above-the-clouds.CqSPGqOP_Z22URCr.avif 1280w, /_astro/above-the-clouds.CqSPGqOP_ZmnY6W.avif 1920w" type="image/avif" sizes="100vw"><source srcset="/_astro/above-the-clouds.CqSPGqOP_mho6N.webp 768w, /_astro/above-the-clouds.CqSPGqOP_ZleW8P.webp 1280w, /_astro/above-the-clouds.CqSPGqOP_1sUgJv.webp 1920w" type="image/webp" sizes="100vw">  <img src="/_astro/above-the-clouds.CqSPGqOP_2qjTOi.jpg" srcset="/_astro/above-the-clouds.CqSPGqOP_19qUaR.jpg 768w, /_astro/above-the-clouds.CqSPGqOP_Z1ionat.jpg 1280w, /_astro/above-the-clouds.CqSPGqOP_2qjTOi.jpg 1920w" alt sizes="100vw" loading="lazy" data-astro-cid-6a2uyp33="true" decoding="async" data-astro-image="constrained" data-astro-image-fit="cover" data-astro-image-pos="center" width="1920" height="1080"> </picture> <div class="container panel glow" data-reveal data-astro-cid-6a2uyp33> <div class="text" data-astro-cid-6a2uyp33> <h2 data-astro-cid-6a2uyp33>Tell us about your project</h2> <p class="lead" data-astro-cid-6a2uyp33>From a single servo drive to a complete unmanned system, tell us what the mission needs and we will come back with a proposal.</p> </div> <a class="btn btn--light" href="/contact-us/" data-astro-cid-6a2uyp33> Contact sales <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right" aria-hidden="true" data-astro-cid-6a2uyp33="true"> <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>  </svg> </a> </div> </section>  </main> <footer class="footer" data-astro-cid-jo6i4kqk> <div class="container" data-astro-cid-jo6i4kqk> <div class="grid" data-astro-c